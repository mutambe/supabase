# =============================================================================
# Supabase self-hosted (Docker Swarm) - variáveis de ambiente
#
# Copie este ficheiro para ".env" e preencha os valores antes do deploy:
#   cp deploy/.env.example deploy/.env
#
# NUNCA faça commit do ficheiro ".env" real (contém segredos). Confirme que
# ".env" está no .gitignore do repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# Infraestrutura / Swarm
# -----------------------------------------------------------------------------
# Topologia de 2 nodes. Os servicos pesados (db, storage, imgproxy) correm
# no node HEAVY (worker) e os leves no node LIGHT (manager). Indique o
# hostname exato de cada node (Swarm) - ver: docker node ls.
# Cada node so precisa das subpastas de ${SUPABASE_VOLUMES_PATH} usadas
# pelos servicos que la correm.
SUPABASE_NODE_HEAVY=vmi2974672
SUPABASE_NODE_LIGHT=vmi2968866

# Caminho absoluto, no node acima, onde estão os ficheiros deste repositório
# (docker/volumes/*) - kong.yml, kong-entrypoint.sh, *.sql, pooler.exs, etc.
SUPABASE_VOLUMES_PATH=/srv/supabase/volumes

# -----------------------------------------------------------------------------
# Segredos principais (gere valores fortes e únicos - nunca use os defaults)
# -----------------------------------------------------------------------------
# Chave secreta usada para assinar os JWT (auth, PostgREST, Realtime, etc.)
# Gere com: openssl rand -base64 40
JWT_SECRET=

# Tempo de expiração do JWT em segundos (ex.: 3600 = 1 hora)
JWT_EXPIRY=3600

# Chaves pública (anon) e de serviço (service_role), geradas a partir do
# JWT_SECRET acima (ver documentação oficial do Supabase self-hosted para o
# script/gerador de chaves).
ANON_KEY=
SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# API (Kong / PostgREST / URLs públicas)
# -----------------------------------------------------------------------------
# URL pública pela qual o Kong é acedido (o Traefik faz proxy para aqui)
API_EXTERNAL_URL=https://supabase.songhai.cc
SUPABASE_PUBLIC_URL=https://supabase.songhai.cc
SITE_URL=https://songhai.cc
ADDITIONAL_REDIRECT_URLS=

# Schemas e limites expostos pelo PostgREST
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# Utilizador/palavra-passe do painel administrativo do Kong (Basic Auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# -----------------------------------------------------------------------------
# Auth (GoTrue)
# -----------------------------------------------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# SMTP para envio de emails (confirmação, recuperação de password, etc.)
SMTP_ADMIN_EMAIL=admin@songhai.cc
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase

# -----------------------------------------------------------------------------
# Studio
# -----------------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=Songhai
STUDIO_DEFAULT_PROJECT=Default Project
PG_META_CRYPTO_KEY=

# -----------------------------------------------------------------------------
# Storage / Imgproxy
# -----------------------------------------------------------------------------
GLOBAL_S3_BUCKET=supabase-storage
STORAGE_TENANT_ID=stub
REGION=local
IMGPROXY_AUTO_WEBP=true

# Credenciais S3 (apenas necessárias se STORAGE_BACKEND for alterado para s3;
# com o backend "file" atual estes valores não são usados mas a app exige
# que existam variáveis definidas).
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# -----------------------------------------------------------------------------
# Realtime
# -----------------------------------------------------------------------------
REALTIME_DB_ENC_KEY=
SECRET_KEY_BASE=

# -----------------------------------------------------------------------------
# Supavisor (connection pooler)
# -----------------------------------------------------------------------------
VAULT_ENC_KEY=
POOLER_TENANT_ID=default
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
